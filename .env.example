# Database: SQLite via node:sqlite (dev) or PostgreSQL (prod)
DATABASE_URL=file:./.data/proofloop.db
# DATABASE_URL=postgresql://proofloop:proofloop@localhost:5432/proofloop

# API
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173

# API auth. REQUIRED in production — the server refuses to boot with
# NODE_ENV=production when neither variable is set.
# PROOFLOOP_API_TOKEN=change-me-long-random-value
# PROOFLOOP_API_KEYS=token1:orgId,token2:orgId

# Required for GitHub/GitLab webhooks (HMAC / shared-token verification)
# GITHUB_WEBHOOK_SECRET=
# GITLAB_WEBHOOK_SECRET=

# Optional Redis (omit for sync execution)
# REDIS_URL=redis://localhost:6379

# Optional OpenAI-compatible LLM (server-side only)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# GitHub App (optional)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=

# Storage
STORAGE_DIR=./storage

# Analyzer impact-graph expansion caps (files analyzed beyond the diff so
# reverse-closure / imported_by edges can fire; same-dir files win first)
# PROOFLOOP_IMPACT_TS_CAP=400
# PROOFLOOP_IMPACT_PY_CAP=200

# Per-command verification timeout override (ms); default 120000
# PROOFLOOP_MAX_CMD_TIMEOUT_MS=120000

# Max LLM-generated claims stitched into the deterministic anchor list
# PROOFLOOP_LLM_CLAIMS_MAX=12
